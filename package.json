{
	"name": "ocrecall",
	"version": "0.0.1",
	"description": "Sync OpenAI Codex sessions to SQLite and recall context from past sessions",
	"keywords": [
		"analytics",
		"codex",
		"context",
		"memory",
		"openai",
		"recall",
		"sqlite"
	],
	"homepage": "https://github.com/spences10/ocrecall#readme",
	"bugs": {
		"url": "https://github.com/spences10/ocrecall/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spences10/ocrecall.git"
	},
	"bin": {
		"ocrecall": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"start": "node ./dist/index.js",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"format": "vp check --fix",
		"test": "vp test --passWithNoTests",
		"test:watch": "vp test watch",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish"
	},
	"dependencies": {
		"citty": "^0.2.2",
		"tinyglobby": "^0.2.16"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"@types/node": "^25.9.0",
		"typescript": "^7.0.0",
		"vite-plus": "^0.2.0",
		"vitest": "^4.1.6"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@11.22.0"
}
