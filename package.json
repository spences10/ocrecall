{
	"name": "ocrecall",
	"version": "0.0.5",
	"description": "Sync OpenAI Codex sessions to SQLite and recall context from past sessions",
	"keywords": [
		"analytics",
		"codex",
		"context",
		"memory",
		"openai",
		"recall",
		"sqlite"
	],
	"homepage": "https://github.com/spences10/ocrecall#readme",
	"bugs": {
		"url": "https://github.com/spences10/ocrecall/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spences10/ocrecall.git"
	},
	"bin": {
		"ocrecall": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/resumable.d.ts",
			"import": "./dist/resumable.js"
		},
		"./resumable": {
			"types": "./dist/resumable.d.ts",
			"import": "./dist/resumable.js"
		}
	},
	"scripts": {
		"build": "vp pack && cp src/schema.sql dist/schema.sql && mkdir -p dist/migrations && cp src/migrations/* dist/migrations/",
		"dev": "pnpm build && vp pack --watch",
		"start": "node ./dist/index.js",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"format": "vp check --fix",
		"test": "vp test",
		"test:watch": "vp test watch",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish"
	},
	"dependencies": {
		"citty": "^0.2.2",
		"tinyglobby": "^0.2.17"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.2",
		"@types/node": "^26.4.1",
		"typescript": "^7.0.2",
		"vite-plus": "^0.3.0",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@12.3.4"
}
